# ============================================================================
# alankar-backend — .env.sample
# Copy this file to `.env` (cmd: `copy .env.sample .env`) and fill in the values.
# NEVER commit the real `.env` — it is gitignored.
# ============================================================================

# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas free tier is enough: https://cloud.mongodb.com
#   Create a free cluster → Database Access (create a user) → Network Access
#   (allow your IP, or 0.0.0.0/0 for now) → Connect → "Drivers" → copy the URI
#   and replace <password> with your database user's password.
# Local MongoDB instead: mongodb://127.0.0.1:27017/alankar
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alankar?retryWrites=true&w=majority

# ---- ImgBB (image hosting) ----
# Free key from https://api.imgbb.com/ — the key is shown on that page immediately.
# Treat it like a password: backend only, never in frontend code, never committed.
IMGBB_API_KEY=paste-your-imgbb-key-here
# Testing only: override the ImgBB endpoint (used by tests/03-upload.test.js
# to run the full upload path against a local stub without spending quota).
# IMGBB_API_URL=https://api.imgbb.com/1/upload

# ---- Admin auth ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here
ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD is read ONLY by `npm run seed:admin` (once) to create the first
# admin login. Afterwards the bcrypt hash in MongoDB is used and this plaintext
# value is never read again — change or delete the line after the first run.
# Minimum 8 characters; the placeholder below is rejected on purpose.
ADMIN_PASSWORD=choose-a-strong-password-here

# ---- CORS ----
# Comma-separated frontend origins allowed to call this API with credentials.
# Leave EMPTY during local development to allow any origin (a warning is logged).
# Production example: https://alankar.me,https://www.alankar.me
CORS_ORIGIN=http://localhost:5173,https://alankar.me
